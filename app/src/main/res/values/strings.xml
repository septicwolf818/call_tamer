    <!-- Onboarding -->
    <string name="onboarding_welcome_title">Welcome to CallTamer</string>
    <string name="onboarding_welcome_body">Temporarily block unwanted calls without adding numbers to a permanent blacklist. Blocks expire automatically.</string>
    <string name="onboarding_permissions_title">Permissions needed</string>
    <string name="onboarding_permissions_body">• Call Screening role — to screen and block incoming calls\n• Notifications — for block expiry alerts\n• Contacts — to pick numbers from your address book\n• Call Log — to block numbers from recent calls</string>
    <string name="onboarding_get_started">Get Started</string>
    <string name="onboarding_checking">Checking permissions…</string>

    <string name="onboarding_role_title">Call Screening Role</string>
    <string name="onboarding_role_body">CallTamer needs to be set as your default Caller ID &amp; Spam app to screen and block incoming calls. Without this role, call blocking will not work at all — calls will ring through normally.</string>
    <string name="onboarding_role_hint">You\'ll be taken to system settings. Tap the toggle to grant CallTamer this role, then press back to return here.</string>
    <string name="onboarding_role_grant">Grant Call Screening Role</string>

    <string name="onboarding_notif_title">Notifications</string>
    <string name="onboarding_notif_body">CallTamer sends a notification when a temporary block expires so you know it\'s been lifted. Without this, you\'d have to open the app to check.</string>
    <string name="onboarding_notif_allow">Allow Notifications</string>

    <string name="onboarding_contacts_title">Contacts Access</string>
    <string name="onboarding_contacts_body">When creating a block, you can pick a number directly from your contacts book instead of typing it manually. This permission lets CallTamer read the phone number from the contact you select. Your contacts list never leaves your device.</string>
    <string name="onboarding_contacts_allow">Allow Contacts Access</string>

    <string name="onboarding_calllog_title">Call Log Access</string>
    <string name="onboarding_calllog_body">When creating a block, you can pick a number from your recent incoming or outgoing calls. This permission lets CallTamer read the number and timestamp from your call log. Your call history never leaves your device.</string>
    <string name="onboarding_calllog_allow">Allow Call Log Access</string>

    <string name="onboarding_skip">Skip — I\'ll do this later</string>
    <string name="onboarding_complete_title">You\'re all set!</string>
    <string name="onboarding_complete_body">CallTamer is ready. You can always change permissions later in Settings.</string>
    <string name="onboarding_start">Start using CallTamer</string>
