    <!-- Onboarding -->
    <string name="onboarding_welcome_title">Witaj w CallTamer</string>
    <string name="onboarding_welcome_body">Tymczasowo blokuj niechciane połączenia bez dodawania numerów do stałej czarnej listy. Blokady wygasają automatycznie.</string>
    <string name="onboarding_permissions_title">Wymagane uprawnienia</string>
    <string name="onboarding_permissions_body">• Rola Call Screening — do blokowania przychodzących połączeń\n• Powiadomienia — o wygaśnięciu blokady\n• Kontakty — do wybierania numerów z książki adresowej\n• Dziennik połączeń — do blokowania numerów z ostatnich połączeń</string>
    <string name="onboarding_get_started">Rozpocznij</string>
    <string name="onboarding_checking">Sprawdzanie uprawnień…</string>

    <string name="onboarding_role_title">Rola Call Screening</string>
    <string name="onboarding_role_body">CallTamer musi być ustawiony jako domyślna aplikacja do identyfikacji dzwoniącego i blokowania spamu, aby móc blokować przychodzące połączenia. Bez tej roli blokowanie nie będzie działać — połączenia będą przechodzić normalnie.</string>
    <string name="onboarding_role_hint">Zostaniesz przeniesiony do ustawień systemowych. Włącz przełącznik, aby przyznać CallTamer tę rolę, a następnie wróć.</string>
    <string name="onboarding_role_grant">Przyznaj rolę Call Screening</string>

    <string name="onboarding_notif_title">Powiadomienia</string>
    <string name="onboarding_notif_body">CallTamer wysyła powiadomienie, gdy tymczasowa blokada wygaśnie, abyś wiedział, że została zdjęta. Bez tego musiałbyś sprawdzać w aplikacji.</string>
    <string name="onboarding_notif_allow">Zezwól na powiadomienia</string>

    <string name="onboarding_contacts_title">Dostęp do kontaktów</string>
    <string name="onboarding_contacts_body">Podczas blokowania numeru możesz wybrać go bezpośrednio z książki adresowej zamiast wpisywać ręcznie. To uprawnienie pozwala CallTamer odczytać numer z wybranego kontaktu. Twoje kontakty nigdy nie opuszczą urządzenia.</string>
    <string name="onboarding_contacts_allow">Zezwól na dostęp do kontaktów</string>

    <string name="onboarding_calllog_title">Dostęp do dziennika połączeń</string>
    <string name="onboarding_calllog_body">Podczas blokowania numeru możesz wybrać go z ostatnich połączeń przychodzących lub wychodzących. To uprawnienie pozwala CallTamer odczytać numer i czas z dziennika połączeń. Twoja historia połączeń nigdy nie opuści urządzenia.</string>
    <string name="onboarding_calllog_allow">Zezwól na dostęp do dziennika połączeń</string>

    <string name="onboarding_skip">Pomiń — zrobię to później</string>
    <string name="onboarding_complete_title">Gotowe!</string>
    <string name="onboarding_complete_body">CallTamer jest gotowy. Uprawnienia możesz zawsze zmienić w Ustawieniach.</string>
    <string name="onboarding_start">Rozpocznij korzystanie</string>
